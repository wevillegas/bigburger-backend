PORT=3100
# Connection string completa de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bigburger?retryWrites=true&w=majority
# Cualquier string random largo, ej: openssl rand -hex 32
JWT_SECRET=
# URL del frontend deployado; la API solo acepta requests de navegador desde este origen (CORS)
FRONTEND_URL=http://localhost:3000

# Cantidad de proxies delante de la app (Render/Heroku: 1). Sin esto, los rate limits ven la IP del proxy
TRUST_PROXY=
# En producción poner NODE_ENV=production: activa la cookie de sesión Secure + SameSite=None
NODE_ENV=development
